# Copy to deploy.env (git-ignored) and fill in. Used by scripts/deploy_azure.sh.
AZ_RESOURCE_GROUP=bingo-rg
AZ_LOCATION=uaenorth
NAME_PREFIX=melbetebingo          # 3-12 lowercase letters/digits

# Required
TELEGRAM_BOT_TOKEN=
SUPER_ADMIN_TELEGRAM_ID=
ADMIN_TOTP_SECRETS=            # TELEGRAM_ID:BASE32SEED,... (admin login is disabled if empty)

# Optional
TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_IDS=
ADMIN_CHAT_ID=
PUBLIC_BASE_URL=               # only if you attach a custom domain; leave empty otherwise

# Database: leave EXTERNAL_DATABASE_URL empty to create Azure Database for PostgreSQL.
# To keep Supabase instead, paste its transaction-pooler URL here.
EXTERNAL_DATABASE_URL=

# Auto-generated on first run and saved back into deploy.env:
# SECRET_KEY=
# POSTGRES_ADMIN_PASSWORD=

# Non-stop rounds: seconds the winner screen shows before the server starts the next round (0 = manual "Go to Lobby")
AUTO_NEXT_ROUND_SECONDS=15
