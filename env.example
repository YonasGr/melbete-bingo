# ============================================================================
# Melbete Bingo - Environment Configuration
# Copy this file to `.env` for local development, or set these as secrets
# on your hosting platform (Render, Railway, Fly.io, Cloud Run, ...).
# See README.md for a step-by-step guide to obtaining each value.
# ============================================================================

# --- Telegram Bot -----------------------------------------------------------
# Get this from @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your bot's @username, WITHOUT the @ (e.g. melbetebingo_bot). Find it in
# @BotFather -> your bot -> it's shown right under the bot's name, or just
# check the URL of your bot's chat: t.me/<this>.
# Used only to build the one-tap deep link in the web app's "Link Telegram
# Account" flow (Profile menu, for players using the web version outside
# Telegram). If left blank, linking still works, but players have to
# manually open the bot and type `/link CODE` instead of tapping a button.
TELEGRAM_BOT_USERNAME=

# Public HTTPS URL where this app is deployed (no trailing slash).
# Used to build the "Open Melbete Bingo" Mini App button.
# Locally, use an https tunnel such as `ngrok http 8000`.
PUBLIC_BASE_URL=https://your-app.example.com
TELEGRAM_GAME_SHORT_NAME=bingo

# How long (seconds) a Telegram Mini App session's signed initData stays
# accepted after the app was opened. Telegram issues this once per launch
# and does NOT refresh it while the app stays open in the background, so
# this needs to comfortably outlast a normal lobby-wait + round, or
# profile/wallet/claim requests and the live WebSocket start silently
# failing partway through a game. Default 21600 = 6 hours.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=21600

# --- Database (any standard Postgres) ---------------------------------------
# Any standard Postgres connection string works - Supabase, Azure Database
# for PostgreSQL, self-hosted, etc. If you're on Supabase specifically, use
# the "Transaction pooler" variant (host contains "pooler.supabase.com",
# port 6543) - this app is a serverless-style backend that opens many
# short-lived connections, which is exactly what the pooler is for. See
# MIGRATING_TO_SUPABASE.md for that walkthrough. Other providers (Azure
# Database for PostgreSQL, etc.) - just use the connection string they give
# you directly.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres
# Running Postgres locally instead (see LOCAL_MIGRATION_GUIDE.md, Track B)?
# Use: postgresql://bingo:bingo@db:5432/bingo

# Connection pool sizing - raise DB_POOL_MAX_SIZE as concurrent players
# grow. The default of 30 comfortably handles a few hundred concurrent
# players polling every ~15s; check your provider's own max_connections
# limit (varies by plan/tier) before raising this much further, especially
# if anything else (the bot process, an admin session) also connects.
# DB_COMMAND_TIMEOUT_SECONDS caps how long any single query may run before
# the connection is freed back to the pool.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=30
DB_COMMAND_TIMEOUT_SECONDS=15

# Leave this false if DATABASE_URL points at a transaction-mode PgBouncer
# pooler (Supabase's recommended pooler) - it doesn't support server-side
# prepared statements at all. If you're connecting directly to Postgres
# with no PgBouncer in front - the normal setup for Azure Database for
# PostgreSQL and most self-hosted setups - you can safely set this to true
# for a small performance bonus. When in doubt, leave it false.
DB_USE_PREPARED_STATEMENTS=false

# --- Application -------------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string
APP_ENV=development
DEBUG=True

# --- Game configuration -------------------------------------------------------
# There is only ever ONE live global round at a time - these tune it.
MAX_PLAYERS_PER_ROOM=100
DEFAULT_DRAW_INTERVAL=2
# Players always mark their own cards; this is kept only for legacy compat
# and should stay False.
AUTO_MARK_ENABLED=False
GAME_STAKE_AMOUNT=10
FREE_CREDIT_AMOUNT=50
# A single player online is enough to start a round - one "caller" can run
# the draw for any number of cards, exactly like a physical bingo hall.
MIN_PLAYERS_TO_START=1
LOBBY_COUNTDOWN_SECONDS=30

# --- Deposits / withdrawals ------------------------------------------------
MIN_DEPOSIT_AMOUNT=50
MAX_DEPOSIT_AMOUNT=70000
MIN_WITHDRAWAL_AMOUNT=200
MAX_WITHDRAWAL_AMOUNT=10000

# --- Admin / payments ----------------------------------------------------------
# Telegram numeric user ID of the ONE super admin. Bootstrapped automatically
# on first startup; from then on, the super admin manages every other admin
# from the in-app admin panel (/admin) - no more env-var admin lists needed.
# Get your numeric ID from @userinfobot on Telegram.
SUPER_ADMIN_TELEGRAM_ID=

# Mandatory second factor for each admin. Use a distinct Base32 seed from
# a password manager or authenticator provisioning flow for every ID.
# Format: TELEGRAM_ID:BASE32SEED,OTHER_TELEGRAM_ID:OTHERBASE32SEED
# Keep this only in your hosting secrets manager. If empty, all admin login
# fails closed.
ADMIN_TOTP_SECRETS=

# Legacy fallback - comma-separated Telegram numeric user IDs that are
# always treated as admins even without a database record. Prefer managing
# admins via the admin panel instead.
ADMIN_TELEGRAM_IDS=
# Optional: a group chat ID where top-up screenshots get forwarded for
# approval. If unset, each admin above is DMed individually (they must have
# started a chat with the bot first).
ADMIN_CHAT_ID=
# First-boot seed only - actual payment methods (account numbers, active
# status) are managed at runtime from the admin panel (/admin) and stored
# in the database, not here.
PAYMENT_METHODS=Telebirr,CBE Birr

# --- Server --------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Local self-hosting only (see LOCAL_MIGRATION_GUIDE.md) ----------------
# Token from `cloudflared tunnel token <tunnel-name>`, used by the
# `cloudflared` service in docker-compose.yml to expose this app publicly
# without port-forwarding. Not needed if you're not running that service.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Player engagement (streaks, round nudges, win-back) --------------------
# Rewards are house-funded BONUS balance (playable, never withdrawable). Quiet hours use Ethiopia time (EAT).
# ENGAGEMENT_STREAK_REWARDS=3:10,7:30        # "days:ETB" pairs; empty disables streak rewards
# ENGAGEMENT_WINBACK_DAYS=7                  # inactive this long -> eligible for a free round
# ENGAGEMENT_WINBACK_BONUS_ETB=10            # 0 disables win-back
# ENGAGEMENT_WINBACK_COOLDOWN_DAYS=30
# ENGAGEMENT_WINBACK_DAILY_BUDGET_ETB=500    # hard cap on win-back bonus paid per day
# ENGAGEMENT_NUDGE_COOLDOWN_HOURS=6
# ENGAGEMENT_NUDGE_MAX_RECIPIENTS=100        # 0 disables "round starting" nudges
# ENGAGEMENT_LOOP_MINUTES=30                 # 0 disables the win-back / streak-reminder job
